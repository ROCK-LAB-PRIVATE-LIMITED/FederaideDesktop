{
  "name": "federaide-electron",
  "version": "1.3.0",
  "description": "FEDERaiDE Electron UI",
  "author": {
    "name": "ROCK LAB",
    "email": "support@rocklab.in"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "fetch:all": "python3 fetch-bin.py --all"
  },
  "dependencies": {
    "dompurify": "^3.2.4",
    "highlight.js": "^11.9.0",
    "katex": "^0.16.11",
    "marked": "^9.1.6",
    "marked-katex-extension": "^5.1.2"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.federaide.desktop",
    "productName": "FEDERaiDE",
    "icon": "assets/icon.png",
    "asar": true,
    "asarUnpack": [
      "*.py",
      "electron_bridge.py",
      "agent_core.py"
    ],
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "renderer.js",
      "electron_bridge.py",
      "agent_core.py",
      "assets/**/*",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/bin",
        "to": "bin"
      },
      {
        "from": "resources/lima",
        "to": "lima"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg"
      ],
      "extraResources": [
        {
          "from": "resources/images/federaide-debian-arm.tar.gz",
          "to": "images/federaide-debian-arm.tar.gz"
        }
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "extraResources": [
        {
          "from": "resources/images/federaide-debian.tar.gz",
          "to": "images/federaide-debian.tar.gz"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development",
      "extraResources": [
        {
          "from": "resources/images/federaide-debian.tar.gz",
          "to": "images/federaide-debian.tar.gz"
        }
      ]
    }
  }
}
