FROM python:3.13-slim-bookworm

# Enforce 256-color palette and persist keyring inside mounted .federate folder
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    TERM=xterm-256color \
    TEXTUAL_COLOR_SYSTEM=256 \
    DISPLAY=:1 \
    XDG_DATA_HOME=/home/federate/.federate/share \
    XDG_CONFIG_HOME=/home/federate/.federate/config \
    XDG_CONFIG_DIRS=/etc/xdg

# Install Debian runtime dependencies, WeasyPrint libraries, fonts, and terminfo
RUN apt-get update && apt-get install -y --no-install-recommends \
    sudo \
    bash \
    git \
    make \
    build-essential \
    gcc \
    g++ \
    curl \
    ca-certificates \
    pkg-config \
    libffi-dev \
    # Pango / Cairo rendering & system fonts for WeasyPrint
    libpango-1.0-0 \
    libpangocairo-1.0-0 \
    libpangoft2-1.0-0 \
    libcairo2 \
    libgdk-pixbuf-2.0-0 \
    libgirepository-1.0-1 \
    gir1.2-pango-1.0 \
    fontconfig \
    fonts-dejavu-core \
    fonts-liberation \
    libopenjp2-7 \
    # Complete Python Tkinter & Tcl/Tk runtime shared libraries
    python3-tk \
    tk \
    tcl \
    tk8.6 \
    tcl8.6 \
    libtk8.6 \
    libtcl8.6 \
    tk8.6-dev \
    tcl8.6-dev \
    # Mesa OpenGL video drivers & software rasterizer (Pygame, Qt, 3D plots)
    libgl1-mesa-dri \
    libglu1-mesa \
    mesa-utils \
    libgl1 \
    libglvnd0 \
    libegl1 \
    # TigerVNC, noVNC & AwesomeWM Window Manager
    tigervnc-standalone-server \
    tigervnc-common \
    novnc \
    websockify \
    awesome \
    awesome-extra \
    picom \
    xdotool \
    x11-utils \
    x11-xserver-utils \
    # Standalone GUI Applications & Icons (No Desktop Environment)
    chromium \
    thunar \
    thunar-archive-plugin \
    xarchiver \
    papirus-icon-theme \
    adwaita-icon-theme \
    gnome-themes-extra \
    # X11 extensions & Qt/PySide runtime dependencies
    libxrender1 \
    libxcomposite1 \
    libxcursor1 \
    libxi6 \
    libxtst6 \
    libxrandr2 \
    libxss1 \
    libxkbcommon-x11-0 \
    dbus \
    dbus-x11 \
    libdbus-1-3 \
    pulseaudio \
    pulseaudio-utils \
    libasound2-plugins \
    ffmpeg \
    # Required for Qt 6.5+ XCB platform plugin
    libxcb-cursor0 \
    libxcb-icccm4 \
    libxcb-image0 \
    libxcb-keysyms1 \
    libxcb-randr0 \
    libxcb-render-util0 \
    libxcb-shape0 \
    libxcb-xfixes0 \
    libxcb-sync1 \
    libx11-xcb1 \
    # Complete terminfo database for pixel-perfect terminal escape sequences
    ncurses-base \
    ncurses-term \
    procps \
    && fc-cache -fv \
    && ln -sf /usr/share/novnc/vnc.html /usr/share/novnc/index.html \
    && rm -rf /var/lib/apt/lists/*

# Grab the official standalone uv binary
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

# Create non-root user, configure passwordless sudo, and set up directories
RUN useradd -m -u 1000 -s /bin/bash federate && \
    echo "federate ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/federate && \
    chmod 0440 /etc/sudoers.d/federate && \
    mkdir -p /workspace /home/federate/.federate && \
    chown -R federate:federate /workspace /home/federate

WORKDIR /app
COPY electron_bridge.py /app/electron_bridge.py


# Install full TUI IDE extras
RUN uv pip install --system --no-cache \
    keyrings.alt \
    "federaide[ide,vision,pdf]"

# Configure GTK Dark Theme and Chromium container flags
RUN mkdir -p /home/federate/.config/gtk-3.0 /home/federate/.config/awesome /etc/chromium.d && \
    echo '[Settings]\ngtk-theme-name=Adwaita-dark\ngtk-icon-theme-name=Papirus-Dark\ngtk-application-prefer-dark-theme=1' > /home/federate/.config/gtk-3.0/settings.ini && \
    echo 'export CHROMIUM_FLAGS="$CHROMIUM_FLAGS --no-sandbox --disable-dev-shm-usage"' > /etc/chromium.d/default-flags && \
    update-alternatives --set x-www-browser /usr/bin/chromium || true && \
    update-alternatives --set gnome-www-browser /usr/bin/chromium || true && \
    chown -R federate:federate /home/federate/.config

# Configure background noVNC, PulseAudio, and AwesomeWM startup script
RUN cat << 'EOF' > /entrypoint.sh
#!/bin/bash
set -e

# 1. Clean up stale X11 lock files and sockets
sudo rm -rf /tmp/.X1-lock /tmp/.X11-unix/X1 /tmp/.X11-unix/X1* /tmp/.X11-unix 2>/dev/null || rm -rf /tmp/.X1-lock /tmp/.X11-unix 2>/dev/null || true
sudo mkdir -p /tmp/.X11-unix && sudo chmod 1777 /tmp/.X11-unix 2>/dev/null || true

# 2. Terminate leftover daemons
sudo pkill -9 -f "Xtigervnc" 2>/dev/null || true
sudo pkill -9 -f "Xvnc" 2>/dev/null || true
sudo pkill -9 -f "websockify" 2>/dev/null || true
sudo pkill -9 -f "awesome" 2>/dev/null || true
sudo pkill -9 -f "pulseaudio" 2>/dev/null || true
sudo pkill -9 -f "ffmpeg" 2>/dev/null || true
sleep 0.3

# 3. Export environment variables and initialize global D-Bus user session bus
export DISPLAY=:1
export XDG_CONFIG_DIRS=/etc/xdg
export XDG_CURRENT_DESKTOP=Awesome
export DESKTOP_SESSION=awesome
eval $(dbus-launch --sh-syntax)

# 4. Start PulseAudio virtual audio server
pulseaudio --start --exit-idle-time=-1 > /dev/null 2>&1 || true
pactl load-module module-null-sink sink_name=DummyOutput sink_properties=device.description="Virtual_Audio" > /dev/null 2>&1 || true
pactl set-default-sink DummyOutput > /dev/null 2>&1 || true

# 5. Start persistent zero-latency HTTP audio streaming loop on port 6081
(
    while true; do
        ffmpeg -nostdin -f pulse -fragment_size 512 -i DummyOutput.monitor -c:a libmp3lame -b:a 128k -f mp3 -fflags nobuffer -flags low_delay -flush_packets 1 -listen 1 http://0.0.0.0:6081/audio.mp3 > /dev/null 2>&1 || true
        sleep 0.2
    done
) &

# 6. Start TigerVNC Standalone Server on DISPLAY :1
Xtigervnc :1 -geometry 1280x800 -depth 24 -rfbport 5900 -SecurityTypes None -noreset -pn > /dev/null 2>&1 &
sleep 0.5

# 7. Start Awesome Window Manager
awesome > /dev/null 2>&1 &
sleep 0.5

# 8. Start noVNC websockify bridge on port 6080
websockify --web /usr/share/novnc 6080 localhost:5900 > /dev/null 2>&1 &

exec "$@"
EOF
RUN chmod +x /entrypoint.sh

# Switch to isolated workspace directory and non-root user
WORKDIR /workspace
USER federate

# Expose noVNC web client and live audio stream ports
EXPOSE 6080 6081

ENTRYPOINT ["/entrypoint.sh"]
CMD ["federaide"]